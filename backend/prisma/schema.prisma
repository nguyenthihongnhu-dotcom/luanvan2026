generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model chi_tiet_phieu_nhap {
  MaChiTietNhap  Int            @id @default(autoincrement())
  MaPhieuNhap    Int
  MaLo           Int
  MaViTri        Int
  SoLuongNhap    Int
  KetQuaQC       String?        @default("Dat") @db.VarChar(50)
  GhiChu         String?        @db.Text
  phieu_nhap_kho phieu_nhap_kho @relation(fields: [MaPhieuNhap], references: [MaPhieuNhap], onDelete: Cascade, onUpdate: NoAction, map: "chi_tiet_phieu_nhap_ibfk_1")
  lo_san_pham    lo_san_pham    @relation(fields: [MaLo], references: [MaLo], onDelete: NoAction, onUpdate: NoAction, map: "chi_tiet_phieu_nhap_ibfk_2")
  vi_tri_kho     vi_tri_kho     @relation(fields: [MaViTri], references: [MaViTri], onDelete: NoAction, onUpdate: NoAction, map: "chi_tiet_phieu_nhap_ibfk_3")

  @@index([MaLo], map: "MaLo")
  @@index([MaPhieuNhap], map: "MaPhieuNhap")
  @@index([MaViTri], map: "MaViTri")
}

model chi_tiet_phieu_xuat {
  MaChiTietXuat  Int            @id @default(autoincrement())
  MaPhieuXuat    Int
  MaLo           Int
  MaViTri        Int
  SoLuongXuat    Int
  phieu_xuat_kho phieu_xuat_kho @relation(fields: [MaPhieuXuat], references: [MaPhieuXuat], onDelete: Cascade, onUpdate: NoAction, map: "chi_tiet_phieu_xuat_ibfk_1")
  lo_san_pham    lo_san_pham    @relation(fields: [MaLo], references: [MaLo], onDelete: NoAction, onUpdate: NoAction, map: "chi_tiet_phieu_xuat_ibfk_2")
  vi_tri_kho     vi_tri_kho     @relation(fields: [MaViTri], references: [MaViTri], onDelete: NoAction, onUpdate: NoAction, map: "chi_tiet_phieu_xuat_ibfk_3")

  @@index([MaLo], map: "MaLo")
  @@index([MaPhieuXuat], map: "MaPhieuXuat")
  @@index([MaViTri], map: "MaViTri")
}

model danh_muc {
  MaDanhMuc  Int     @id @default(autoincrement())
  TenDanhMuc String  @db.VarChar(255)
  MoTa       String? @db.Text
}

model dieu_chinh_ton_kho {
  MaDieuChinh                                             Int         @id @default(autoincrement())
  SoPhieuDieuChinh                                        String      @unique(map: "SoPhieuDieuChinh") @db.VarChar(50)
  MaTonKho                                                Int
  SoLuongCu                                               Int
  SoLuongMoi                                              Int
  LyDo                                                    String?     @db.Text
  TrangThai                                               String?     @default("ChoDuyet") @db.VarChar(30)
  NguoiTao                                                Int?
  NguoiPheDuyet                                           Int?
  ton_kho                                                 ton_kho     @relation(fields: [MaTonKho], references: [MaTonKho], onDelete: NoAction, onUpdate: NoAction, map: "dieu_chinh_ton_kho_ibfk_1")
  nguoi_dung_dieu_chinh_ton_kho_NguoiTaoTonguoi_dung      nguoi_dung? @relation("dieu_chinh_ton_kho_NguoiTaoTonguoi_dung", fields: [NguoiTao], references: [MaNguoiDung], onDelete: NoAction, onUpdate: NoAction, map: "dieu_chinh_ton_kho_ibfk_2")
  nguoi_dung_dieu_chinh_ton_kho_NguoiPheDuyetTonguoi_dung nguoi_dung? @relation("dieu_chinh_ton_kho_NguoiPheDuyetTonguoi_dung", fields: [NguoiPheDuyet], references: [MaNguoiDung], onDelete: NoAction, onUpdate: NoAction, map: "dieu_chinh_ton_kho_ibfk_3")

  @@index([MaTonKho], map: "MaTonKho")
  @@index([NguoiPheDuyet], map: "NguoiPheDuyet")
  @@index([NguoiTao], map: "NguoiTao")
}

model khach_hang {
  MaKhachHang    Int              @id @default(autoincrement())
  TenKhachHang   String           @db.VarChar(150)
  NguoiLienHe    String?          @db.VarChar(100)
  SoDienThoai    String?          @db.VarChar(20)
  Email          String?          @db.VarChar(100)
  DiaChi         String?          @db.Text
  phieu_xuat_kho phieu_xuat_kho[]
}

model lo_san_pham {
  MaLo                Int                   @id @default(autoincrement())
  MaSanPham           Int
  SoLo                String                @db.VarChar(50)
  NgaySanXuat         DateTime?             @db.Date
  NgayHetHan          DateTime?             @db.Date
  NgayNhap            DateTime?             @db.Date
  chi_tiet_phieu_nhap chi_tiet_phieu_nhap[]
  chi_tiet_phieu_xuat chi_tiet_phieu_xuat[]
  san_pham            san_pham              @relation(fields: [MaSanPham], references: [MaSanPham], onDelete: Cascade, onUpdate: NoAction, map: "lo_san_pham_ibfk_1")
  ton_kho             ton_kho[]

  @@index([MaSanPham], map: "MaSanPham")
}

model nguoi_dung {
  MaNguoiDung                                                     Int                  @id @default(autoincrement())
  HoTen                                                           String               @db.VarChar(100)
  MaNhanVien                                                      String?              @unique(map: "MaNhanVien") @db.VarChar(50)
  Email                                                           String?              @unique(map: "Email") @db.VarChar(100)
  SoDienThoai                                                     String?              @db.VarChar(20)
  VaiTro                                                          String               @db.VarChar(50)
  TrangThai                                                       String?              @default("HoatDong") @db.VarChar(20)
  dieu_chinh_ton_kho_dieu_chinh_ton_kho_NguoiTaoTonguoi_dung      dieu_chinh_ton_kho[] @relation("dieu_chinh_ton_kho_NguoiTaoTonguoi_dung")
  dieu_chinh_ton_kho_dieu_chinh_ton_kho_NguoiPheDuyetTonguoi_dung dieu_chinh_ton_kho[] @relation("dieu_chinh_ton_kho_NguoiPheDuyetTonguoi_dung")
  phieu_nhap_kho                                                  phieu_nhap_kho[]
  phieu_xuat_kho                                                  phieu_xuat_kho[]
}

model nha_cung_cap {
  MaNCC          Int              @id @default(autoincrement())
  TenNCC         String           @db.VarChar(150)
  NguoiLienHe    String?          @db.VarChar(100)
  Email          String?          @db.VarChar(100)
  SoDienThoai    String?          @db.VarChar(20)
  phieu_nhap_kho phieu_nhap_kho[]
}

model phieu_nhap_kho {
  MaPhieuNhap         Int                   @id @default(autoincrement())
  SoPhieuNhap         String                @unique(map: "SoPhieuNhap") @db.VarChar(50)
  MaNCC               Int?
  NgayNhap            DateTime?             @db.Date
  TrangThai           String?               @default("NhapHang") @db.VarChar(30)
  NguoiTao            Int?
  chi_tiet_phieu_nhap chi_tiet_phieu_nhap[]
  nha_cung_cap        nha_cung_cap?         @relation(fields: [MaNCC], references: [MaNCC], onDelete: NoAction, onUpdate: NoAction, map: "phieu_nhap_kho_ibfk_1")
  nguoi_dung          nguoi_dung?           @relation(fields: [NguoiTao], references: [MaNguoiDung], onDelete: NoAction, onUpdate: NoAction, map: "phieu_nhap_kho_ibfk_2")

  @@index([MaNCC], map: "MaNCC")
  @@index([NguoiTao], map: "NguoiTao")
}

model phieu_xuat_kho {
  MaPhieuXuat         Int                   @id @default(autoincrement())
  SoPhieuXuat         String                @unique(map: "SoPhieuXuat") @db.VarChar(50)
  NgayXuat            DateTime?             @db.Date
  MaDonHangThamChieu  String?               @db.VarChar(50)
  TrangThai           String?               @default("XuatHang") @db.VarChar(30)
  NguoiTao            Int?
  MaKhachHang         Int
  chi_tiet_phieu_xuat chi_tiet_phieu_xuat[]
  khach_hang          khach_hang            @relation(fields: [MaKhachHang], references: [MaKhachHang], onUpdate: Restrict, map: "FK_phieuxuatkho_khachhang")
  nguoi_dung          nguoi_dung?           @relation(fields: [NguoiTao], references: [MaNguoiDung], onDelete: NoAction, onUpdate: NoAction, map: "phieu_xuat_kho_ibfk_1")

  @@index([NguoiTao], map: "NguoiTao")
  @@index([MaKhachHang], map: "FK_phieuxuatkho_khachhang")
}

model san_pham {
  MaSanPham         Int           @id @default(autoincrement())
  SKU               String        @unique(map: "SKU") @db.VarChar(50)
  TenSanPham        String        @db.VarChar(200)
  DanhMuc           String?       @db.VarChar(100)
  DonViTinh         String?       @db.VarChar(30)
  TonKhoToiThieu    Int?          @default(0)
  NgayCanhBaoHetHan DateTime?     @db.Date
  lo_san_pham       lo_san_pham[]
}

model ton_kho {
  MaTonKho           Int                  @id @default(autoincrement())
  MaViTri            Int
  MaLo               Int
  SoLuong            Int                  @default(0)
  dieu_chinh_ton_kho dieu_chinh_ton_kho[]
  vi_tri_kho         vi_tri_kho           @relation(fields: [MaViTri], references: [MaViTri], onDelete: Cascade, onUpdate: NoAction, map: "ton_kho_ibfk_1")
  lo_san_pham        lo_san_pham          @relation(fields: [MaLo], references: [MaLo], onDelete: Cascade, onUpdate: NoAction, map: "ton_kho_ibfk_2")

  @@index([MaLo], map: "MaLo")
  @@index([MaViTri], map: "MaViTri")
}

model vi_tri_kho {
  MaViTri             Int                   @id @default(autoincrement())
  KhuVuc              String                @db.VarChar(50)
  Ke                  String?               @db.VarChar(50)
  Tang                String?               @db.VarChar(20)
  MaViTriCha          Int?
  TrangThai           String?               @default("Trong") @db.VarChar(20)
  chi_tiet_phieu_nhap chi_tiet_phieu_nhap[]
  chi_tiet_phieu_xuat chi_tiet_phieu_xuat[]
  ton_kho             ton_kho[]
  vi_tri_kho          vi_tri_kho?           @relation("vi_tri_khoTovi_tri_kho", fields: [MaViTriCha], references: [MaViTri], onUpdate: NoAction, map: "vi_tri_kho_ibfk_1")
  other_vi_tri_kho    vi_tri_kho[]          @relation("vi_tri_khoTovi_tri_kho")

  @@index([MaViTriCha], map: "MaViTriCha")
}
